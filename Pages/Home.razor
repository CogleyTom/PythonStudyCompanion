@page "/"
@using System.Text.Json
@using PythonStudyCompanion.Models
@using PythonStudyCompanion.Services
@inject ProgressService Tracker
@inject FlashcardService Content

<PageTitle>Home | Python Study Companion</PageTitle>

<section class="page-heading">
    <p class="eyebrow">A LITTLE PRACTICE. EVERY DAY.</p>
    <h1>Build your Python confidence.</h1>
    <p>Small steps, stronger skills. Your next chapter starts here.</p>
</section>

<section class="hero-card" aria-labelledby="daily-heading">
    <div>
        <span class="pill">YOUR DAILY MOMENTUM</span>
        <h2 id="daily-heading">Make room for<br />a little learning.</h2>
        <p>Review a concept, solve a problem, and keep moving forward. Just 5-15 minutes at a time.</p>
        <a class="button button-light" href="flashcards">Explore flashcards <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="code-art" aria-hidden="true">
        <span class="code-dots"><i></i><i></i><i></i></span>
        <code><span>def</span> grow():<br />&nbsp; learn()<br />&nbsp; practice()<br />&nbsp; <span>return</span> progress</code>
    </div>
</section>

<section class="dashboard-section" aria-labelledby="overview-heading">
    <div class="section-heading">
        <h2 id="overview-heading">Your daily snapshot</h2>
        <a href="progress">View progress <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="stats-grid">
        <article class="stat-card">
            <span class="stat-label">Cards due</span>
            <strong>@(Tracker.IsAvailable && cardsLoaded ? cards.Count(card => Tracker.IsCardDue(card.Id)).ToString() : "\u2014")</strong>
            <span class="stat-note">Includes new and scheduled cards</span>
        </article>
        <article class="stat-card">
            <span class="stat-label">Cards studied</span>
            <strong>@(Tracker.IsAvailable ? Tracker.CardsStudied.ToString() : "\u2014")</strong>
            <span class="stat-note">All saved review attempts</span>
        </article>
        <article class="stat-card">
            <span class="stat-label">Quiz accuracy</span>
            <strong>@(Tracker.IsAvailable && Tracker.QuizAccuracy is int accuracy ? $"{accuracy}%" : "\u2014")</strong>
            <span class="stat-note">Across all saved quiz answers</span>
        </article>
        <article class="stat-card">
            <span class="stat-label">Study streak</span>
            <strong>@(Tracker.IsAvailable ? Tracker.CurrentStreak.ToString() : "\u2014") <small>days</small></strong>
            <span class="stat-note">Every day is a fresh start</span>
        </article>
    </div>
    <div class="daily-progress">
        <div class="section-heading">
            <span>Today's study progress</span>
            <strong>@(Tracker.IsAvailable ? $"{Tracker.ActivityOn(Tracker.Today)} actions" : "Unavailable")</strong>
        </div>
        <progress value="@(Tracker.IsAvailable ? Math.Min(Tracker.ActivityOn(Tracker.Today), Tracker.DailyGoal) : 0)"
                  max="@Tracker.DailyGoal" aria-label="Today's study activity toward a ten-action goal"></progress>
        <p>Daily goal: @Tracker.DailyGoal card ratings, quiz answers, or explicitly reviewed coding exercises.</p>
        @if (catalogError is not null)
        {
            <p role="status">@catalogError</p>
        }
    </div>
</section>

@code {
    private IReadOnlyList<Flashcard> cards = [];
    private bool cardsLoaded;
    private string? catalogError;

    protected override async Task OnInitializedAsync()
    {
        await Tracker.InitializeAsync();
        try
        {
            cards = await Content.LoadAsync();
            cardsLoaded = true;
        }
        catch (Exception exception) when (exception is HttpRequestException or JsonException or OperationCanceledException)
        {
            catalogError = "Flashcard content couldn't be loaded, so the due-card count is unavailable.";
        }
    }
}

<section class="dashboard-section" aria-labelledby="study-heading">
    <div class="section-heading">
        <h2 id="study-heading">Find your focus</h2>
        <span class="muted">Short sessions. Lasting skills.</span>
    </div>
    <div class="action-grid">
        <a class="action-card" href="flashcards">
            <span class="action-symbol" aria-hidden="true">Aa</span>
            <h3>Refresh your memory</h3>
            <p>Build understanding, one flashcard at a time.</p>
            <span class="text-link">Explore flashcards &rarr;</span>
        </a>
        <a class="action-card" href="practice">
            <span class="action-symbol blue" aria-hidden="true">&lt;/&gt;</span>
            <h3>Put it into practice</h3>
            <p>Make concepts click with quizzes and coding exercises.</p>
            <span class="text-link">Explore practice &rarr;</span>
        </a>
    </div>
</section>

<section class="dashboard-section" aria-labelledby="topics-heading">
    <div class="section-heading">
        <h2 id="topics-heading">Your learning path</h2>
        <span class="muted">8 topics</span>
    </div>
    <p class="section-description">Start with the basics and build toward interview confidence. Choose your topics in Flashcards.</p>
    <ol class="topic-list">
        <li>Python Fundamentals</li>
        <li>Python Functions</li>
        <li>Lists, Tuples, Sets, and Dictionaries</li>
        <li>Object-Oriented Programming</li>
        <li>Data Structures</li>
        <li>Algorithms and Coding Patterns</li>
        <li>Big O Complexity</li>
        <li>Technical Interview Questions</li>
    </ol>
</section>
